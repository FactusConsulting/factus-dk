---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EngagementTimeline from "../../components/EngagementTimeline.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { services, serviceIcons, serviceHref, type Service } from "../../data/services";
import { technologyBySlug, engagementsWithTags } from "../../data/technologies";
import { site } from "../../config/site";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const relatedTechnologies = service.technologies.map((slug) => {
  const technology = technologyBySlug(slug);
  if (!technology) throw new Error(`Ydelsen "${service.slug}" peger på ukendt teknologi "${slug}"`);
  return technology;
});
const relevant = engagementsWithTags(service.engagementTags).slice(0, 4);
const otherServices = services.filter((s) => s.slug !== service.slug);

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.metaDescription,
  url: new URL(serviceHref(service), site.url).toString(),
  provider: { "@id": `${site.url}#organization` },
  areaServed: { "@type": "Country", name: "Denmark" },
};
---

<BaseLayout title={service.title} description={service.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="relative overflow-hidden bg-white border-b border-ink-100">
    <div class="absolute inset-0 bg-grid pointer-events-none" aria-hidden="true"></div>
    <div class="container-page relative pt-12 md:pt-16 pb-16 md:pb-20">
      <Breadcrumbs items={[{ label: "Ydelser", href: "/#ydelser" }, { label: service.title }]} />
      <div class="mt-10 flex items-center gap-3">
        <div class="flex items-center justify-center w-11 h-11 rounded-lg bg-brand-50 text-brand-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={serviceIcons[service.icon]} />
          </svg>
        </div>
        <span class="eyebrow">{service.title}</span>
      </div>
      <h1 class="heading-1 mt-5 max-w-4xl">{service.headline}</h1>
      <p class="lead mt-6 max-w-2xl">{service.intro}</p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/#kontakt" class="btn-primary">
          Book et uforpligtende møde
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        {service.cta && (
          <a
            href={service.cta.href}
            target={service.cta.external ? "_blank" : undefined}
            rel={service.cta.external ? "noopener" : undefined}
            class="btn-secondary"
          >
            {service.cta.label}{service.cta.external && " ↗"}
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="section-y bg-ink-50/50 border-b border-ink-100">
    <div class="container-page">
      <span class="eyebrow">Typiske situationer</span>
      <h2 class="heading-2 mt-3 max-w-2xl">Kender I det her?</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {service.situations.map((situation) => (
          <li class="card flex items-start gap-4">
            <svg class="w-5 h-5 mt-0.5 text-brand-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="prose-body">{situation}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page">
      <span class="eyebrow">Tilgang</span>
      <h2 class="heading-2 mt-3 max-w-2xl">Sådan griber jeg det an.</h2>
      <ol class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {service.approach.map((step, i) => (
          <li>
            <span class="font-display text-4xl font-bold text-brand-600/30">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="heading-3 mt-2">{step.title}</h3>
            <p class="prose-body mt-3 text-[0.95rem]">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-y bg-ink-50/50 border-y border-ink-100">
    <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-7">
        <span class="eyebrow">Leverancer</span>
        <h2 class="heading-2 mt-3">Det får I.</h2>
        <ul class="mt-8 space-y-3">
          {service.deliverables.map((d) => (
            <li class="flex items-start gap-3 text-ink-800">
              <svg class="w-5 h-5 mt-0.5 text-brand-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <span class="eyebrow">Teknologier</span>
        <p class="prose-body mt-3">Værktøjer jeg typisk bruger til denne type opgave — klik for at se konkret erfaring.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {relatedTechnologies.map((t) => (
            <a
              href={`/erfaring/${t.slug}`}
              class="px-3 py-1.5 rounded-md bg-white border border-ink-200 text-sm text-ink-700 font-medium hover:border-brand-600 hover:text-brand-700 transition-colors"
            >{t.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {relevant.length > 0 && (
    <section class="section-y">
      <div class="container-page">
        <div class="flex items-end justify-between flex-wrap gap-6">
          <div class="max-w-2xl">
            <span class="eyebrow">Relevant erfaring</span>
            <h2 class="heading-2 mt-3">Hvor jeg har gjort det før.</h2>
          </div>
          <a href="/erfaring" class="btn-secondary">Se al erfaring</a>
        </div>
        <div class="mt-12">
          <EngagementTimeline engagements={relevant} />
        </div>
      </div>
    </section>
  )}

  <section class:list={["section-y", relevant.length > 0 && "bg-ink-50/50 border-t border-ink-100"]}>
    <div class="container-page">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-500">Andre ydelser</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {otherServices.map((s) => (
          <a
            href={serviceHref(s)}
            class="group flex items-center gap-3 rounded-lg border border-ink-200 bg-white px-4 py-3 text-sm font-semibold text-ink-900 hover:border-brand-600 transition-colors"
          >
            <svg class="w-4 h-4 text-brand-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={serviceIcons[s.icon]} />
            </svg>
            {s.title}
          </a>
        ))}
      </div>

      <div class="mt-16">
        <CtaBanner
          title="Lad os tage en snak."
          text="Første samtale er altid uforpligtende. Vi bruger 30 minutter på at forstå jeres situation, og du går derfra med konkret feedback."
        />
      </div>
    </div>
  </section>
</BaseLayout>
