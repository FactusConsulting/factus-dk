---
import { services, serviceIcons, serviceHref } from "../data/services";
---

<section id="ydelser" class="section-y bg-ink-50/50 border-y border-ink-100">
  <div class="container-page">
    <div class="max-w-2xl">
      <span class="eyebrow">Ydelser</span>
      <h2 class="heading-2 mt-3">Det jeg laver — typisk i korte, fokuserede forløb.</h2>
      <p class="lead mt-5">
        Leverancen er en fungerende platform, en velstruktureret pipeline eller et
        team der kan bære det videre. Ikke rapporter der ender i en skuffe.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((s) => (
        <article class="card group flex flex-col">
          <div class="flex items-center justify-center w-11 h-11 rounded-lg bg-brand-50 text-brand-700 group-hover:bg-brand-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d={serviceIcons[s.icon]} />
            </svg>
          </div>
          <h3 class="heading-3 mt-5">
            <a href={serviceHref(s)} class="hover:text-brand-700 transition-colors">{s.title}</a>
          </h3>
          <p class="prose-body mt-3 text-[0.95rem]">{s.body}</p>
          <ul class="mt-5 space-y-2 flex-1">
            {s.bullets.map((b) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-700">
                <svg class="w-4 h-4 mt-0.5 text-brand-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
            <a
              href={serviceHref(s)}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:gap-2.5 transition-all"
            >
              Læs mere
              <span class="sr-only">om {s.title}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            {s.cta && (
              <a
                href={s.cta.href}
                target={s.cta.external ? "_blank" : undefined}
                rel={s.cta.external ? "noopener" : undefined}
                class="text-sm font-semibold text-ink-600 hover:text-ink-900 transition-colors"
              >
                {s.cta.label}{s.cta.external && " ↗"}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
