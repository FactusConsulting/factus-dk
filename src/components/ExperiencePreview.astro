---
import { engagements } from "../data/experience";
import EngagementTimeline from "./EngagementTimeline.astro";

const recent = engagements.slice(0, 5);
---

<section id="erfaring" class="section-y bg-ink-50/50 border-y border-ink-100">
  <div class="container-page">
    <div class="flex items-end justify-between flex-wrap gap-6">
      <div class="max-w-2xl">
        <span class="eyebrow">Seneste engagementer</span>
        <h2 class="heading-2 mt-3">Hvor jeg har været på arbejde.</h2>
        <p class="lead mt-5">
          Et udsnit af mine seneste freelance-engagementer. Den fulde liste —
          {engagements.length} udvalgte opgaver siden 2006 hos danske og nordiske
          organisationer i både privat og offentlig sektor — finder du på erfaringssiden.
        </p>
      </div>
      <a href="/erfaring" class="btn-secondary">
        Se hele listen
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <div class="mt-12">
      <EngagementTimeline engagements={recent} />
    </div>
  </div>
</section>
